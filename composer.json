{
    "name": "ghostwriter/psalm-plugin",
    "description": "Provides a plugin for Psalm",
    "license": "BSD-3-Clause",
    "type": "psalm-plugin",
    "keywords": [
        "ghostwriter",
        "psalm",
        "psalm-plugin",
        "static analysis",
        "dev"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/psalm-plugin",
    "support": {
        "issues": "https://github.com/ghostwriter/psalm-plugin/issues",
        "source": "https://github.com/ghostwriter/psalm-plugin",
        "rss": "https://github.com/ghostwriter/psalm-plugin/releases.atom",
        "security": "https://github.com/ghostwriter/psalm-plugin/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ghostwriter/config": "^2.1.3",
        "ghostwriter/console": "^0.2.3",
        "ghostwriter/container": "^7.0.2",
        "ghostwriter/event-dispatcher": "^6.1.3",
        "ghostwriter/filesystem": "^0.2.0",
        "ghostwriter/shell": "^0.1.5",
        "vimeo/psalm": "^6.16.1"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "ghostwriter/coding-standard": "dev-main",
        "ghostwriter/phpunit-assertions": "^0.1.0",
        "mockery/mockery": "^1.6.12",
        "phpunit/phpunit": "^13.2.1"
    },
    "replace": {
        "ghostwriter/example-psalm-plugin": "*",
        "ghostwriter/phpunit-psalm-plugin": "*",
        "ghostwriter/psalm-plugin-tester": "*",
        "ghostwriter/psalm-sandbox": "*"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ghostwriter\\PsalmPlugin\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "platform-check": true,
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "ghostwriter": {
            "container": {
                "provider": [
                    "Ghostwriter\\PsalmPlugin\\Container\\PsalmPluginProvider"
                ]
            }
        },
        "psalm": {
            "pluginClass": "Ghostwriter\\PsalmPlugin\\Plugin"
        },
        "thanks": {
            "name": "ghostwriter/psalm-plugin",
            "url": "https://github.com/ghostwriter/psalm-plugin"
        }
    },
    "scripts": {
        "bin_psalm1": "vendor/ghostwriter/coding-standard/tools/phar/psalm --no-cache --threads=1",
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "vendor/ghostwriter/coding-standard/tools/phar/infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpunit": [
            "@xdebug",
            "vendor/bin/phpunit --do-not-cache-result --colors=always"
        ],
        "psalm": "@bin_psalm --show-info=true --no-diff --shepherd --stats",
        "psalm:alter": "@bin_psalm --alter --allow-backwards-incompatible-changes=false --safe-types",
        "psalm:baseline": "@bin_psalm --no-diff --set-baseline=psalm-baseline.xml",
        "psalm:dry-run": "@bin_psalm --alter --issues=all --dry-run",
        "psalm:fix": "@bin_psalm --alter --issues=UnnecessaryVarAnnotation",
        "psalm:security": "@bin_psalm --no-diff --taint-analysis",
        "psalm:update": "@bin_psalm --no-diff --update-baseline=psalm-baseline.xml",
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
